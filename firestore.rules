rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data: only owner can read/write.
    // READ also permits the owner's linked CREDIT doc, whose document id is the
    // device-registration UUID (NOT the Firebase Auth uid) but carries
    // google_uid == the owner's uid. Needed for the client-side real-time credit
    // listener (UserCreditsSync) — without it the balance can't sync across devices.
    // WRITE stays strict: the credit doc is written only server-side by Cloud
    // Functions (Admin SDK), never by the client.
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || (resource != null && resource.data.google_uid == request.auth.uid));
      // The push fields — fcmToken, platform, lastActiveAt, fcmOptIn, pushHoldout — are NOT
      // written by the client directly. Token registration goes through the register_push_token
      // Cloud Function (Admin SDK, bypasses these rules), keyed by the canonical device-
      // registration user_id (the credit-doc id, which is a server UUID, NOT the Firebase Auth
      // uid). This is required because the credit doc is server-write-only AND anonymous users
      // have no Firebase Auth (`request.auth == null`) — an owner-write rule could never let an
      // anonymous device attach its token. Other server-owned push fields (lastPromoSentAt,
      // lastPromoCampaignId, fcmTokenInvalidatedAt) are likewise Admin-SDK only.
      // The owner-only write below stays for any future client-owned field on this doc; note it
      // does NOT (and cannot) cover the credit doc itself, whose id != request.auth.uid.
      allow write: if request.auth != null && request.auth.uid == userId;

      match /checklists/{checklistId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Existing collections used by Cloud Functions (server-side access via Admin SDK)
    // usage, credits_restore_log, credits_refill_log, premium_events_log,
    // rc_customers, rc_events — accessed only by Admin SDK, default deny is correct.
  }
}
