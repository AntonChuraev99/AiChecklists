# Firebase Cloud Functions Environment Variables
# DO NOT COMMIT: Use this as template, never store actual secrets in .env file
#
# For deployment:
# 1. Set environment variables before running deploy.sh:
#    export GEMINI_API_KEY="your_actual_key"
#    ./deploy.sh
#
# 2. Or use Google Cloud Secret Manager (recommended for production):
#    gcloud secrets create gemini-api-key --data-file=-
#    gcloud functions deploy analyze_and_fill_checklist --set-secrets="GEMINI_API_KEY=gemini-api-key:latest"

# Google Cloud Project Configuration
PROJECT_ID=aichecklists-40230
REGION=us-central1

# Gemini API Key
# Generate from: https://aistudio.google.com/app/apikey
# SECURITY: This should NOT be committed. Use environment variables or Google Cloud Secrets.
GEMINI_API_KEY=your_key_here

# Firebase Admin SDK Service Account
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# SECURITY: Never commit service account JSON. Store in Google Cloud Secret Manager.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json

# Optional: Runtime configuration
LOG_LEVEL=INFO
TIMEOUT_SECONDS=60
MEMORY_MB=512

# --- Promotional push (send_promotions_batch) ---
# Amplitude server-side ingestion key for the push_sent event (CTR denominator).
# SECRET — store in Secret Manager as `amplitude-server-key`, never commit a real value.
# This is a SERVER API key from Amplitude project 786722 (Settings → Projects → API Keys),
# NOT the public browser ingestion key. Empty → push_sent emit is skipped (send still works).
AMPLITUDE_SERVER_API_KEY=your_amplitude_server_key_here
# US endpoint by default (matches init.js serverZone 'US'). EU projects override:
# AMPLITUDE_HTTP_ENDPOINT=https://api.eu.amplitude.com/2/httpapi
AMPLITUDE_HTTP_ENDPOINT=https://api2.amplitude.com/2/httpapi
# Optional admin gate for the promo sender. SECRET — store as `push-admin-key`. When set,
# every caller (Cloud Scheduler body / manual trigger) must present a matching admin_key.
PUSH_ADMIN_KEY=your_push_admin_key_here
