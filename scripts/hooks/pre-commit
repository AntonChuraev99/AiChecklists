#!/usr/bin/env bash
# Local pre-commit hook: docs leak gate + bug-pattern L1 static gate.
#
# INSTALL:  cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# This is FAST FEEDBACK, not the binding gate. `.git/hooks` is not versioned, is absent on a
# fresh clone, is skipped by `--no-verify`, and is overwritten whenever review-rules/run.py
# reinstalls itself. The binding gate is `.github/workflows/docs-leak-guard.yml`, which runs on
# every PR from a clean checkout where none of those escape hatches exist.
#
# Keep this file in sync with .git/hooks/pre-commit after any review-rules reinstall.

# ---- docs leak gate (added 2026-08-18, when docs/ stopped being gitignored) ----
SCAN="$(git rev-parse --show-toplevel)/scripts/docs_leak_scan.py"
if [ -f "$SCAN" ]; then
  python "$SCAN" --staged || {
    echo ""
    echo "Commit blocked: a staged doc carries numbers or identifiers that must not be public."
    echo "This repo is public — a push is instant and permanent. Strip the numbers, or keep the"
    echo "doc out of git (docs/marketing/, docs/reports/, docs/PRODUCT.md stay ignored)."
    exit 1
  }
fi

# ---- bug-pattern L1 static gate (installed by review-rules/run.py) ----
RUNNER="$HOME/.claude/review-rules/run.py"
[ -f "$RUNNER" ] || { echo "review-rules: runner not found at $RUNNER (skipping)"; exit 0; }
python "$RUNNER" --staged || {
  echo ""
  echo "Commit blocked by review-rules (HIGH static finding). Fix, or bypass once with:"
  echo "    git commit --no-verify   (NOT recommended)"
  exit 1
}
exit 0
