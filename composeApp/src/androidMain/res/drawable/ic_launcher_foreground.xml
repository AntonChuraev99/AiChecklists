<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally transparent. The v5 launcher mark is volumetric raster art, so the whole mark
     (gradient + tile + check) lives in the background layer (drawable-*dpi/ic_launcher_background.webp)
     and is centred inside the 66dp safe zone. This layer only keeps the foreground slot filled; launcher
     parallax moves the whole mark with the background. Themed icons use ic_launcher_monochrome. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
