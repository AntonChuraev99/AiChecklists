<resources>
    <string name="app_name">Gisti - AI Checklists</string>

    <!-- Widget -->
    <string name="widget_name">Checklist</string>
    <string name="widget_description">Display and check off items from your checklist</string>
    <string name="widget_loading">Loading…</string>

    <!-- Widget UI States -->
    <string name="widget_not_found">Checklist not found</string>
    <string name="widget_select_another">Select another</string>
    <string name="widget_tap_to_configure">Tap to configure</string>
    <string name="widget_select_checklist_display">Select a checklist to display</string>
    <string name="widget_no_items">No items</string>
    <string name="widget_checked">Checked</string>
    <string name="widget_unchecked">Unchecked</string>

    <!-- Widget failure feedback (toasts). The widget leaves no app UI behind and Glance cannot
         render a snackbar, so a toast is the only surface available. Reached only when the device
         cannot build WorkManager, which every Glance update goes through. -->
    <string name="widget_toggle_failed">Could not update the checklist</string>
    <string name="widget_toggle_saved_refresh_failed">Item saved, but the widget could not refresh</string>
    <string name="widget_config_saved_refresh_failed">Widget saved, but it could not refresh</string>

    <!-- Reminder Notifications -->
    <string name="reminder_all_completed">All items completed!</string>
    <string name="reminder_notification_channel">Checklist Reminders</string>
    <string name="reminder_notification_channel_desc">Notifications for checklist reminders and deadlines</string>
    <string name="reminder_notification_tap">Tap to open</string>
    <plurals name="reminder_items_remaining">
        <item quantity="one">%1$d item remaining</item>
        <item quantity="other">%1$d items remaining</item>
    </plurals>

    <!-- Push / Promotions Notifications (FCM re-engagement). Separate user toggle from the
         checklist_reminders channel, so muting this never silences reminders the user set. -->
    <string name="promotions_notification_channel">Tips &amp; Offers</string>
    <string name="promotions_notification_channel_desc">Product tips, weekly summaries and offers. Reminders you set are a separate channel and stay on.</string>

    <!-- Local retention pushes (AlarmManager, on-device data). Honest copy, no fake urgency. -->
    <!-- Streak-save: a daily-habit recurring checklist still has open items in the delivery window. -->
    <string name="retention_streak_title">Keep it going</string>
    <plurals name="retention_streak_body">
        <item quantity="one">%1$d item left in %2$s today</item>
        <item quantity="other">%1$d items left in %2$s today</item>
    </plurals>
    <!-- Overdue: a partially-done checklist left untouched for a day or more. -->
    <string name="retention_overdue_title">Still on your list</string>
    <plurals name="retention_overdue_body">
        <item quantity="one">%1$d item still open in %2$s</item>
        <item quantity="other">%1$d items still open in %2$s</item>
    </plurals>
    <!-- Weekly digest (promotions channel): honest cross-checklist summary of what is still open. -->
    <string name="retention_digest_title">Your weekly check-in</string>
    <plurals name="retention_digest_body_open">
        <item quantity="one">%1$d item is waiting across your %2$d checklists.</item>
        <item quantity="other">%1$d items are waiting across your %2$d checklists.</item>
    </plurals>
    <string name="retention_digest_body_caught_up">All caught up across %1$d checklists. Nice work!</string>
    <!-- Come-back: one-shot D0->D1 nudge ~22h after the user's first checklist (name + open count). -->
    <string name="retention_comeback_title">Pick up where you left off</string>
    <plurals name="retention_comeback_body">
        <item quantity="one">%1$d item still waiting in %2$s</item>
        <item quantity="other">%1$d items still waiting in %2$s</item>
    </plurals>

    <!-- ACTION_PROCESS_TEXT selection-toolbar menu labels (must stay short) -->
    <string name="process_text_create_ai">Checklist from text</string>
    <string name="process_text_add_to_existing">Add to checklist</string>
    <string name="process_text_new_checklist">New checklist</string>
    <string name="process_text_fill_ai">Fill (AI)</string>
    <string name="process_text_empty">No text selected</string>
</resources>
